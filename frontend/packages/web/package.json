{
  "name": "drone-simulator",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noUnusedLocals false && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "openapi-typescript ../../../contract/modeling.openapi.yaml -o src/api/modeling.d.ts && openapi-typescript ../../../contract/agents.openapi.yaml -o src/api/agents.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/three": "^0.183.1",
    "cesium": "^1.133.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^8.1.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.183.2"
  }
}
